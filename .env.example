# Copy to .env. Never commit .env. Names are read by agent/src/deployar/core/config.py (B-02).

# Data (Compose services; the agent runs on the host)
DATABASE_URL=postgresql+asyncpg://deployar:deployar@localhost:5432/deployar
REDIS_URL=redis://localhost:6379/0

# Secrets. Generate each with: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
DEPLOYAR_TOKEN_KEYS={"1":"<base64 32 bytes>"}
DEPLOYAR_TOKEN_KEY_VERSION=1
APPROVAL_SECRET=<base64 32 bytes>
DEPLOYAR_PASSPHRASE=<single-user login passphrase>

# LLM: claude = Claude Agent SDK on the local Claude Code login (decision 2); boxapi = servers (decision 14); fake = tests.
LLM_BACKEND=claude
BOXAPI_BASE_URL=https://ai.boxapi.ir/ai/v1
BOXAPI_API_KEY=
BOXAPI_KEY_SECOND=
BOXAPI_MODEL=anthropic/claude-haiku-5.5
BOXAPI_MODEL_SECOND=openai/gpt-5.4-mini   # the second key's allow list has only this one

# Liara and GitHub tokens are NOT here: paste them in the web UI (Settings > Connections); stored encrypted.
LIARA_API_BASE=https://api.liara.ir

# Coder worktrees (B-22)
DEPLOYAR_WORKDIR=~/.deployar/work

# Web -> agent
AGENT_URL=http://localhost:8800
