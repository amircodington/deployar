# Copy to .env. Never commit .env. Names are read by agent/src/hamkar/core/config.py (B-02).

# Data (Compose services; the agent runs on the host)
DATABASE_URL=postgresql+asyncpg://hamkar:hamkar@localhost:5432/hamkar
REDIS_URL=redis://localhost:6379/0

# Secrets. Generate each with: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
HAMKAR_TOKEN_KEYS={"1":"<base64 32 bytes>"}
HAMKAR_TOKEN_KEY_VERSION=1
APPROVAL_SECRET=<base64 32 bytes>
HAMKAR_PASSPHRASE=<single-user login passphrase>

# LLM: claude = Claude Agent SDK on the local Claude Code login (decision 2). boxapi later.
LLM_BACKEND=claude
BOXAPI_BASE_URL=https://ai.boxapi.ir/ai/v1
BOXAPI_API_KEY=

# Liara and GitHub tokens are NOT here: paste them in the web UI (Settings > Connections); stored encrypted.
LIARA_API_BASE=https://api.iran.liara.ir

# Coder worktrees (B-22)
HAMKAR_WORKDIR=~/.hamkar/work

# Web -> agent
AGENT_URL=http://localhost:8000
